import { job, step, workflow } from "gagen";

const BUILD = job("build", {
    runsOn: "ubuntu-latest",
    steps: [
        step({ uses: "actions/checkout@v4" }),
        step({
            name: "Setup node",
            uses: "actions/setup-node@v4",
            with: { "node-version-file": ".nvmrc", cache: "npm" },
        }),
        step({ name: "Install packages", run: "npm ci" }),
        step({ name: "Check workflow generation", run: "npm run ci:check" }),
        step({ name: "Check", run: "npm run check" }),
        step({ name: "Build", run: "npm run build" }),
        step({
            name: "Upload artifacts",
            if: "github.event_name != 'pull_request'",
            uses: "actions/upload-pages-artifact@v3",
            with: { path: "dist/" },
        }),
    ],
});

const DEPLOY = job("deploy", {
    if: "github.event_name != 'pull_request'",
    runsOn: "ubuntu-latest",
    needs: [BUILD],
    permissions: { pages: "write", "id-token": "write" },
    environment: {
        name: "github-pages",
        url: "${{ steps.deployment.outputs.page_url }}",
    },
    steps: [
        step({
            name: "Deploy to GitHub Pages",
            id: "deployment",
            uses: "actions/deploy-pages@v4",
        }),
    ],
});

workflow({
    name: "deploy",
    on: {
        pull_request: {},
        push: { branches: ["main"] },
        workflow_dispatch: {},
    },
    permissions: { contents: "read" },
    jobs: [BUILD, DEPLOY],
}).writeOrLint({
    filePath: new URL("./deploy.generated.yml", import.meta.url),
    header: "# Generated by deploy.mts. Run npm run ci:generate; do not edit directly.",
});
