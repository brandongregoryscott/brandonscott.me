---
import Header from "../components/Header.astro";
import { ThemeControl } from "../components/ThemeControl";
import "../styles/reset.css";
import "../styles/index.css";
import "../styles/utilities.css";

interface Props {
    title?: string;
    description?: string;
    contentClass?: string;
    noIndex?: boolean;
}

const {
    title = "Brandon Scott",
    description = "Software engineer, open source contributor, and builder.",
    contentClass = "prose",
    noIndex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        {noIndex && <meta name="robots" content="noindex, nofollow" />}
        <title>{title === 'Brandon Scott' ? title : `${title} · Brandon Scott`}</title>
        <link rel="icon" href="/media/favicon.ico" />
        <script is:inline>
            try {
                const theme = localStorage.getItem("site-theme");

                if (theme === "light" || theme === "dark") {
                    document.documentElement.dataset.theme = theme;
                }
            } catch {}
        </script>
    </head>
    <body>
        <a class="skip-link" href="#content">
            Skip to content
        </a>
        <Header />
        <main id="content" class:list={["main-layout-content", contentClass]}>
            <slot />
        </main>
        <footer class="site-settings">
            {import.meta.env.DEV && <a href="/components/">Components</a>}
            <ThemeControl client:load />
        </footer>
    </body>
</html>
