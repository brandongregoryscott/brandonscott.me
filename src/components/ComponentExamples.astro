import "../styles/components.css";
---

<div class="component-sheet">
    <h1>Components</h1>
    <section><h2>Typography</h2><h3>Heading</h3><p>I'm a software engineer that's passionate about open source software, quality code, new technology, and building things.</p><p class="monospace">React & TypeScript / 0123456789</p></section>
    <section><h2>Links and buttons</h2><div class="component-actions"><a href="/about/">About</a><a class="sample-button" href="/projects/">Projects</a><a class="sample-button secondary" href="/resume/" target="_blank" rel="noopener noreferrer">Resume</a><button type="button" disabled>Disabled</button></div></section>
    <section class="prose"><h2>Code</h2><p>Inline <code>npm run build</code></p><pre><code>{'export const theme = {\n    background: "#eae8ed",\n    accent: "#603b91",\n};'}</code></pre></section>
    <section class="prose"><h2>Lists</h2><ul><li>React & TypeScript</li><li>Open source software</li><li>Developer tools</li></ul></section>
    <section class="prose"><h2>Blockquote</h2><blockquote><p>ESLint plugin to enforce consistent, readable TypeScript code with automatic code fixes.</p></blockquote></section>
    <section class="prose"><h2>Table</h2><table><thead><tr><th>Project</th><th>Type</th></tr></thead><tbody><tr><td>kazoo</td><td>VS Code extension</td></tr><tr><td>eslint-plugin-collation</td><td>ESLint plugin</td></tr></tbody></table></section>
    <section><h2>Form controls</h2><div class="sample-fields"><label>Text<input type="text" placeholder="Text" /></label><label>Select<select><option>React</option><option>TypeScript</option></select></label><label class="checkbox-label"><input type="checkbox" /> Checkbox</label></div></section>
    <section><h2>Colors</h2><div class="palette"><div class="swatch canvas">Background</div><div class="swatch surface">Surface</div><div class="swatch accent">Accent</div><div class="swatch ink">Text</div></div></section>
</div>
