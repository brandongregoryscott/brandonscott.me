<label class="theme-control">Theme
    <select id="theme" aria-label="Color theme">
        <option value="system">System</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
    </select>
</label>

<script>
    const selector = document.querySelector<HTMLSelectElement>("#theme");
    if (selector) {
        selector.value = document.documentElement.dataset.theme || "system";
        selector.addEventListener("change", () => {
            const theme = selector.value;
            if (theme === "system") delete document.documentElement.dataset.theme;
            else document.documentElement.dataset.theme = theme;
            try {
                if (theme === "system") localStorage.removeItem("site-theme");
                else localStorage.setItem("site-theme", theme);
            } catch {}
        });
    }
</script>
